{
    "ts": 1768928534,
    "experiment_name": "Exp5-GNN-GAT",
    "paths": {
        "pretrained_model": "data/pretrained_model",
        "raw_data_root": "data/data",
        "processed_data_root": "data/processed_data",
        "output_root": "output",
        "train_data_path": "data/data/train.json",
        "dev_data_path": "data/data/dev.json"
    },
    "env": {
        "cuda_device_id": 0,
        "num_cpu_threads": 25,
        "use_amp": false,
        "seed": 42
    },
    "train": {
        "train_batch_size": 16,
        "eval_batch_size": 32,
        "learning_rate": 2e-05,
        "num_epochs": 60,
        "grad_accum_steps": 2,
        "weight_decay": 0.01,
        "warmup_ratio": 0.03,
        "lr_gnn_mult": 3.0,
        "grad_clip_norm": 1.0,
        "type_loss_weight": 1.0,
        "sp_loss_weight": 5.0,
        "early_stop": {
            "enable": true,
            "metric": "joint_f1",
            "mode": "max",
            "patience": 30,
            "min_delta": 1e-06
        },
        "lr_logging_mode": "optimizer"
    },
    "preprocess": {
        "max_seq_len": 512,
        "max_query_tokens": 50,
        "max_doc_tokens": 4096,
        "doc_window_overlap_words": 128,
