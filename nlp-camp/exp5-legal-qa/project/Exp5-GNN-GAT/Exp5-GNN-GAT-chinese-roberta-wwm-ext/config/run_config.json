            0.6500000000000001,
            0.7000000000000001,
            0.7500000000000001,
            0.8,
            0.8500000000000001,
            0.9000000000000001,
            0.9500000000000001
        ],
        "sp_threshold_fine_step": 0.01,
        "sp_threshold_fine_radius": 0.05
    },
    "model": {
        "hetero_gnn_layers": 2,
        "hetero_gnn_dropout": 0.1,
